{
  "name": "@construct-space/cli",
  "version": "0.5.4",
  "description": "Construct CLI — build spaces, interact with the operator, chat, vibe",
  "type": "module",
  "bin": {
    "construct": "bin/construct"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/build/vite-preset.js",
      "types": "./dist/build/vite-preset.d.ts"
    }
  },
  "peerDependencies": {
    "vite": "^6.0.0",
    "@vitejs/plugin-vue": "^5.0.0"
  },
  "dependencies": {
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0"
  },
  "scripts": {
    "postinstall": "node install.cjs"
  },
  "files": [
    "bin/",
    "binaries/",
    "dist/",
    "install.cjs"
  ],
  "keywords": [
    "construct",
    "space",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/construct-space/cli"
  }
}
